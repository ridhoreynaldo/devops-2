# 01-infra/.env.example
# Salin menjadi ".env" lalu isi dengan password yang KUAT & UNIK.
#   cp .env.example .env
# File .env TIDAK BOLEH di-commit (sudah masuk .gitignore).
#
# Cara generate password acak yang aman:
#   openssl rand -base64 24

# Password user "postgres" (dipakai juga oleh pgbouncer userlist.txt)
POSTGRES_PASSWORD=GANTI_DENGAN_PASSWORD_ACAK_KUAT

# Password user "sa" SQL Server (min. 8 karakter, kombinasi huruf/angka/simbol)
MSSQL_SA_PASSWORD=GANTI_DENGAN_PASSWORD_ACAK_KUAT

# Password Redis
REDIS_PASSWORD=GANTI_DENGAN_PASSWORD_ACAK_KUAT
