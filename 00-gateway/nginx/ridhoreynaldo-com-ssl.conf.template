# Template vhost HTTPS ridhoreynaldo.com.
# Dipasang oleh bootstrap.sh ke conf.d/ridhoreynaldo-com-ssl.conf
# HANYA bila sertifikat Let's Encrypt sudah terbit (agar nginx -t tidak gagal).
server {
    listen 443 ssl;
    http2 on;
    server_name ridhoreynaldo.com www.ridhoreynaldo.com;

    ssl_certificate /etc/letsencrypt/live/ridhoreynaldo.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ridhoreynaldo.com/privkey.pem;

    include /etc/nginx/snippets/security-headers.conf;

    resolver 127.0.0.11 valid=30s;
    set $upstream_portfolio http://app_portfolio:3000;

    location / {
        limit_req zone=req_limit_per_ip burst=20 nodelay;
        limit_conn conn_limit_per_ip 50;

        include /etc/nginx/snippets/proxy.conf;
        proxy_set_header Host $host;

        proxy_pass $upstream_portfolio;
    }
}
