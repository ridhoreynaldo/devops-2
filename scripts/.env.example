# scripts/.env.example
# Salin menjadi ".env" lalu isi kredensial rclone Google Drive.
#   cp .env.example .env
# File .env TIDAK BOLEH di-commit (sudah masuk .gitignore).
#
# Cara mendapatkan token: jalankan sekali secara interaktif
#   rclone config
# lalu salin client_id, client_secret, dan token JSON yang dihasilkan.

RCLONE_DRIVE_CLIENT_ID=GANTI_DENGAN_CLIENT_ID_GOOGLE
RCLONE_DRIVE_CLIENT_SECRET=GANTI_DENGAN_CLIENT_SECRET_GOOGLE
RCLONE_DRIVE_TOKEN={"access_token":"","token_type":"Bearer","refresh_token":"GANTI","expiry":""}
